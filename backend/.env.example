# NVIDIA NIM API Keys (get from https://build.nvidia.com)
NVIDIA_NIM_API_KEY=nvapi-your-primary-nvidia-nim-key
NVIDIA_NIM_BACKUP_KEY=nvapi-your-backup-nvidia-nim-key

# JWT Authentication Config
JWT_SECRET=your-256-bit-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Database
DATABASE_PATH=./salesgenie.db

# CORS Allowed Origins
FRONTEND_URL=http://localhost:5173,https://salesgenie.vercel.app

# Server Port
PORT=8000
